{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-portfolio.local/schemas/evaluation-cases.schema.json",
  "title": "CareerAnswerEvaluationCases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "route",
        "expectedDocumentIds",
        "expectedChunkIds",
        "forbiddenDocumentIds",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "enum": ["exact", "grounded", "unsupported"]
        },
        "expectedDocumentIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectedChunkIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbiddenDocumentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "history": {
          "description": "Earlier turns for a follow-up question. Conversation context, never evidence.",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "content"],
            "properties": {
              "role": {
                "enum": ["user", "assistant"]
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
