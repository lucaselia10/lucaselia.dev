{
  "name": "@career-portfolio/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @career-portfolio/scripts index && pnpm --filter @career-portfolio/scripts sync && astro dev",
    "build": "pnpm --filter @career-portfolio/scripts index && pnpm --filter @career-portfolio/scripts sync && astro build",
    "preview": "astro preview",
